# Copy to .env. Every variable is prefixed RW_.
RW_ENV=development
# SQLite for local dev; Postgres in production, e.g.
# RW_DATABASE_URL=postgresql+psycopg://ridewave:ridewave@localhost:5432/ridewave
RW_DATABASE_URL=sqlite:///./ridewave.db
# The address phones use to reach this API (your laptop's LAN IP when testing on a phone).
RW_PUBLIC_BASE_URL=http://192.168.1.10:8030
RW_CORS_ORIGINS=http://localhost:8081

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RW_JWT_SECRET=
RW_ACCESS_TOKEN_MINUTES=15
RW_REFRESH_TOKEN_DAYS=30
# Dev only — returns the password-reset token in the API response because no
# e-mail sender is configured. Never enable in production.
RW_EXPOSE_RESET_TOKEN=true

# Self-hosted LiveKit (livekit-server --dev uses devkey / secret)
RW_LIVEKIT_URL=ws://192.168.1.10:7880
RW_LIVEKIT_API_KEY=devkey
RW_LIVEKIT_API_SECRET=secret

RW_STOP_REQUEST_TTL_MINUTES=10
RW_LOCATION_LIVE_SECONDS=60
RW_LOCATION_RETENTION_DAYS=7
